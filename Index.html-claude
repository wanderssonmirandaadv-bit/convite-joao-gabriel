<!DOCTYPE html>
<!-- convite-joao-gabriel | versao 20260924-final -->
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Aniversário do João Gabriel - 7 anos</title>
<meta name="description" content="Convite para o aniversário de 7 anos do João Gabriel - 02/10/2026, 16h.">
<meta name="theme-color" content="#000000">
<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    background: #000;
    overflow-x: hidden;
  }
  body {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    -webkit-text-size-adjust: 100%;
  }
  .convite {
    position: relative;
    width: 100%;
    max-width: 560px;
    line-height: 0;
  }
  .convite img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-select: none;
    user-select: none;
    pointer-events: none;
  }
  /* Segurança: nada além do convite pode aparecer na página */
  body > *:not(main):not(script) { display: none !important; }
  .area {
    z-index: 10;
    position: absolute;
    display: block;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    text-decoration: none;
    font-size: 0;
    color: transparent;
  }
  .area:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.85);
    outline-offset: 2px;
  }

  /* Posições em % sobre a imagem (ajuste aqui se necessário) */
  .a-local  { left: 6.3%;  top: 74.2%; width: 27.5%; height: 6.6%; }
  .a-agenda { left: 36.6%; top: 74.2%; width: 27%;   height: 6.6%; }
  .a-whats  { left: 66%;   top: 74.2%; width: 28%;   height: 6.6%; }
  .a-musica { left: 16%;   top: 81.6%; width: 68%;   height: 6.4%;   }
</style>
</head>
<body>

<main class="convite">
  <img id="arte" src="convite-naruto.png?v=20260924" alt="Convite de aniversário de 7 anos do João Gabriel - 02/10/2026, 16h, Dom Bosco - Colégio Bilíngue" decoding="async">

  <a id="btn-local"  class="area a-local"  href="#" target="_blank" rel="noopener noreferrer" aria-label="Ver localização no Google Maps">Localização</a>
  <a id="btn-agenda" class="area a-agenda" href="#" target="_blank" rel="noopener noreferrer" aria-label="Adicionar à agenda">Adicionar à agenda</a>
  <a id="btn-whats"  class="area a-whats"  href="#" target="_blank" rel="noopener noreferrer" aria-label="Compartilhar no WhatsApp">Compartilhar no WhatsApp</a>
  <a id="btn-musica" class="area a-musica" href="#" target="_blank" rel="noopener noreferrer" aria-label="Ouvir Blue Bird - Ikimonogakari">Música</a>
</main>

<script>
(function () {
  "use strict";

  /* ---------- Dados do evento ---------- */
  var ENDERECO = "Av. Fernando Vilela, 152 - Martins, Uberlândia - MG, 38400-458";
  var LOCAL    = "Dom Bosco - Colégio Bilíngue";
  var TITULO   = "Aniversário do João Gabriel - 7 anos";
  var DESCRICAO = "Aniversário de 7 anos do João Gabriel.";

  /* Data/hora locais (Uberlândia, horário de Brasília): 02/10/2026, 16:00 às 18:00 */
  var INICIO = "20261002T160000";
  var FIM    = "20261002T180000";
  var FUSO   = "America/Sao_Paulo";

  /* ---------- Música ----------
     Para usar um áudio local autorizado no futuro, coloque o arquivo na mesma
     pasta (ex.: "musica.mp3") e preencha abaixo: var AUDIO_LOCAL = "musica.mp3";
     Enquanto estiver vazio, o botão abre a busca no YouTube. */
  var AUDIO_LOCAL = "";
  var BUSCA_MUSICA = "Blue Bird Ikimonogakari Naruto";

  /* ---------- Links ---------- */
  var enc = encodeURIComponent;

  var urlMaps = "https://www.google.com/maps/search/?api=1&query=" +
                enc(LOCAL + ", " + ENDERECO);

  var urlAgenda = "https://calendar.google.com/calendar/render?action=TEMPLATE" +
                  "&text="     + enc(TITULO) +
                  "&dates="    + INICIO + "/" + FIM +
                  "&ctz="      + enc(FUSO) +
                  "&details="  + enc(DESCRICAO) +
                  "&location=" + enc(LOCAL + ", " + ENDERECO);

  var urlYoutube = "https://www.youtube.com/results?search_query=" + enc(BUSCA_MUSICA);

  function textoConvite() {
    return "🎉 Você está convidado para o aniversário de 7 anos do João Gabriel! 🥳\n\n" +
           "📅 02/10/2026\n" +
           "⏰ 16h\n" +
           "📍 " + LOCAL + "\n" +
           "Av. Fernando Vilela, 152 - Martins, Uberlândia - MG\n\n" +
           "Esperamos você! 🎉🍥";
  }

  function urlPagina() {
    return window.location.href.split("#")[0];
  }

  function urlWhatsApp() {
    return "https://wa.me/?text=" + enc(textoConvite() + "\n\n" + urlPagina());
  }

  /* ---------- Ligações ---------- */
  function $(id) { return document.getElementById(id); }

  /* Segurança: remove qualquer imagem que não seja a arte final */
  var imgs = document.getElementsByTagName("img");
  for (var i = imgs.length - 1; i >= 0; i--) {
    if (imgs[i].id !== "arte") { imgs[i].parentNode.removeChild(imgs[i]); }
  }

  $("btn-local").href  = urlMaps;
  $("btn-agenda").href = urlAgenda;
  $("btn-whats").href  = urlWhatsApp();
  $("btn-musica").href = urlYoutube;

  /* WhatsApp: tenta o compartilhamento nativo do celular; se não houver, usa o link wa.me */
  $("btn-whats").addEventListener("click", function (e) {
    if (navigator.share) {
      e.preventDefault();
      navigator.share({
        title: TITULO,
        text: textoConvite(),
        url: urlPagina()
      }).catch(function (err) {
        if (err && err.name === "AbortError") { return; } /* usuário cancelou */
        window.open(urlWhatsApp(), "_blank", "noopener");
      });
    }
  });

  /* Música: se houver áudio local, alterna tocar/pausar; senão, abre o YouTube */
  if (AUDIO_LOCAL) {
    var audio = new Audio(AUDIO_LOCAL);
    audio.loop = true;
    audio.preload = "none";
    $("btn-musica").removeAttribute("target");
    $("btn-musica").addEventListener("click", function (e) {
      e.preventDefault();
      if (audio.paused) {
        var p = audio.play();
        if (p && p.catch) { p.catch(function () { window.open(urlYoutube, "_blank", "noopener"); }); }
      } else {
        audio.pause();
      }
    });
  }
})();
</script>

</body>
</html>
